# 仅用于说明变量名，请勿把真实密钥提交到 GitHub。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选，默认值为 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Coze 每日 PDF 接收接口。请分别生成高强度随机值，只配置在 Coze/Vercel/本地 .env.local。
COZE_INGEST_TOKEN=
CODEX_MANAGER_TOKEN=

# Vercel Blob Store 连接后由 Vercel 自动提供，本地开发可用 vercel env pull 获取。
BLOB_READ_WRITE_TOKEN=
